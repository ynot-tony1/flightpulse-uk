# Copy to .env (web) / .env (ingestor) as needed. Never commit real values.

# ---- Database (server-only, deferred until CockroachDB Cloud is provisioned) ----
# Full-privilege connection used by Prisma migrate in local dev only.
DATABASE_URL="postgresql://user:password@host:26257/flight_intelligence?sslmode=verify-full"

# Used by the ingestion service (insert/update aviation + ingestion records only).
INGEST_DATABASE_URL="postgresql://flight_ingestor:password@host:26257/flight_intelligence?sslmode=verify-full"

# Used only by the manual migration workflow. Never configured in the Vercel app.
MIGRATION_DATABASE_URL="postgresql://flight_migrator:password@host:26257/flight_intelligence?sslmode=verify-full"

# ---- Public web app config (safe to expose to the browser) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"
NEXT_PUBLIC_DEFAULT_MAP_LATITUDE="54.5"
NEXT_PUBLIC_DEFAULT_MAP_LONGITUDE="-3.5"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="5"

# ---- Server-only app config ----
MAP_MAX_ROUTES="100"
API_CACHE_TTL_SECONDS="3600"
LOG_LEVEL="info"

# ---- GitHub Actions ingestion switches (repository variables, not secrets) ----
INGESTION_ENABLED="true"
AIRPORT_STATS_ENABLED="true"
PUNCTUALITY_STATS_ENABLED="true"
AIRLINE_STATS_ENABLED="true"
